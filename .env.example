# Copy this file to .env (cp .env.example .env) and fill in your own values.
# .env is gitignored: it never leaves your machine.

# ── Signing key ─────────────────────────────────────────────
# Use a dedicated hot wallet that holds only what the bot trades, plus gas.
# Leave empty to run in paper mode only.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Optional: a different key for one chain (overrides PRIVATE_KEY there)
# PRIVATE_KEY_ETHEREUM=
# PRIVATE_KEY_ROBINHOOD=

# ── Chains ──────────────────────────────────────────────────
# PulseChain is always on. List the other chains to enable; leave empty for all.
CHAINS=ethereum,robinhood

# ── RPC endpoints (optional, comma-separated, tried before the public defaults) ──
# RPC_URL_PULSECHAIN=
# RPC_URL_ETHEREUM=
# RPC_URL_ROBINHOOD=
# Multicall3 read batching (one aggregate3 eth_call per batch of reads). 0 = every read on its own.
# MULTICALL=0

# ── Friends' copies (optional; README → Friends' copies) ─────
# npm run friends:setup writes FRIENDS_SECRET here. It locks friends' keys; keep it.
# FRIENDS_SECRET=
# FRIENDS_PORT=3850

# ── Your own phone (optional; README → Phone access) ────────
# npm run host:password writes these. The hash is scrypt; the password is not stored.
# HOST_LOGIN=owner
# HOST_PASSWORD_HASH=
# HOST_SESSION=1
# Tailnet hostname only (no https://). tailscale serve sends this as Host.
# GATEWAY_HOST=your-mac.your-tailnet.ts.net

# ── Engine (optional; defaults shown) ───────────────────────
# PORT=3847
# POLL_MS=10000
# APPROVAL_MODE=exact
# MAX_RETRIES=1
# RETRY_DELAY_MS=5000
# STATE_FILE=data/state.json
# CANDLE_DIR=data/candles
# CANDLES_GECKO=on
# MAX_TOKEN_TAX_PCT=10
# TAX_RECHECK_MIN=30
