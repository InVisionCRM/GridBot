# Copy this file to .env (cp .env.example .env) and fill in your own values.
# .env is gitignored: it never leaves your machine.

# ── Signing key ─────────────────────────────────────────────
# Use a dedicated hot wallet that holds only what the bot trades, plus gas.
# Leave empty to run in paper mode only.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Optional: a different key for one chain (overrides PRIVATE_KEY there)
# PRIVATE_KEY_ETHEREUM=
# PRIVATE_KEY_ROBINHOOD=

# ── Chains ──────────────────────────────────────────────────
# PulseChain is always on. List the other chains to enable; leave empty for all.
CHAINS=ethereum,robinhood

# ── RPC endpoints (optional, comma-separated, tried before the public defaults) ──
# RPC_URL_PULSECHAIN=
# RPC_URL_ETHEREUM=
# RPC_URL_ROBINHOOD=
# Multicall3 read batching (one aggregate3 eth_call per batch of reads). 0 = every read on its own.
# MULTICALL=0

# ── Friends' copies (optional; README → Friends' copies) ─────
# npm run friends:setup writes FRIENDS_SECRET here. It locks friends' keys; keep it.
# FRIENDS_SECRET=
# FRIENDS_PORT=3850

# ── Your own phone (optional; README → Phone access) ────────
# npm run host:password writes these. The hash is scrypt; the password is not stored.
# HOST_LOGIN=owner
# HOST_PASSWORD_HASH=
# HOST_SESSION=1
# Tailnet hostname only (no https://). tailscale serve sends this as Host.
# GATEWAY_HOST=your-mac.your-tailnet.ts.net

# ── Bridge quote keys (optional; host app only) ─────────────
# Removed from the environment at startup and never logged or sent to the UI.
# Leave empty for keyless quotes. These never belong in frontend code.
# Across sends the key as Authorization: Bearer.
#   https://docs.across.to/introduction/api-keys
#   https://docs.across.to/api-reference
# Relay sends the key as the x-api-key header.
#   https://docs.relay.link/references/api/api-keys
# Li.Fi sends the key as the x-lifi-api-key header.
#   https://docs.li.fi/api-reference/authentication
ACROSS_API_KEY=
RELAY_API_KEY=
LIFI_API_KEY=
# Across integrator id. Off when empty. Exactly 4 hex characters, with an optional 0x.
# On /swap/approval it is the integratorId query parameter.
# On a direct depositV3 it is appended to the calldata as 1dc0de plus the raw id.
#   https://docs.across.to/introduction/api-keys
#   https://docs.across.to/guides/migration/suggested-fees-to-swap
ACROSS_INTEGRATOR_ID=

# ── Engine (optional; defaults shown) ───────────────────────
# PORT=3847
# POLL_MS=5000
# APPROVAL_MODE=exact
# MAX_RETRIES=1
# RETRY_DELAY_MS=5000
# STATE_FILE=data/state.json
# CANDLE_DIR=data/candles
# CANDLES_GECKO=on
# MAX_TOKEN_TAX_PCT=10
# TAX_RECHECK_MIN=30
